# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올리지 않는다.
# 전부 비워 둬도 로컬에서는 돌아간다 (SQLite + 로컬 사진 폴더 + Mock AI).

# --- AI 사진 분류 (없으면 Mock) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# VISION_PROVIDER=mock            # mock / openai / anthropic 강제 지정
# OPENAI_VISION_MODEL=gpt-4o-mini

# --- DB (없으면 backend/var/app.db) ---
# DATABASE_URL=postgresql://...   # Supabase > Project Settings > Database > Connection string

# --- 사진 저장소 (없으면 backend/var/uploads/) ---
# STORAGE=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=           # service_role 키. 서버 환경변수에만, 프론트에 넣지 않음
# SUPABASE_BUCKET=reports         # 비공개 버킷

# --- 공공데이터 (poc/fetch_aed.py) ---
DATA_GO_KR_AED_KEY=
