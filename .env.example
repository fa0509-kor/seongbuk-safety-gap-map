# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올리지 않는다.
# 전부 비워 둬도 로컬에서는 돌아간다 (SQLite + 로컬 사진 폴더 + Mock AI).
# 설명은 항상 값 위의 줄에 둔다. 값 뒤에 설명을 붙이지 않는다.

# --- AI 사진 분류 (없으면 Mock) ---
# 팀 기본은 Claude (10/26). 키는 Claude Console(platform.claude.com)에서
ANTHROPIC_API_KEY=
# 공급자를 강제로 고를 때: mock / openai / anthropic
VISION_PROVIDER=anthropic
# 모델 (기본 claude-sonnet-5-5)
# ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
# OpenAI로 바꿀 때만
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# --- DB (없으면 backend/var/app.db) ---
# Supabase > Connect > Transaction pooler(포트 6543) 주소. 비밀번호에 @ # / : ? 가 있으면 안 됨
# DATABASE_URL=postgresql://...

# --- 사진 저장소 (없으면 backend/var/uploads/) ---
# STORAGE=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# Secret key(sb_secret_...). 서버 환경변수에만, 프론트에 넣지 않음
# SUPABASE_SERVICE_KEY=
# 비공개 버킷 이름
# SUPABASE_BUCKET=reports

# --- 공공데이터 (poc/fetch_aed.py) ---
DATA_GO_KR_AED_KEY=
